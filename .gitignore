# Working notes: hypotheses, sub-tasks and candidate lists per branch.
# Ignored here, in a committed file, so everyone sees the same repository.
work/

# Python bytecode, build output and test caches.
__pycache__/
*.py[co]
.pytest_cache/
.venv/
*.egg-info/
dist/

# Generated by hatch-vcs from the Git tag.
src/*/_version.py
.coverage
coverage.xml
htmlcov/
scripts/.mutate-recovery.json

# Roy's photos of the opener and board: may show private details
docs/photos/

# The laptop build of the controller tests, and ESPHome's own output.
firmware/build/
firmware/build-coverage/
firmware/.esphome/
# Wi-Fi password and keys for the controller; secrets.example.yaml shows the shape.
firmware/secrets.yaml

# Manufacturer documents (copyright): kept locally, never committed. Sources: docs/vendor-sources.md
docs/vendor/

# KiCad local state
hardware/*-backups/
hardware/*.kicad_prl
hardware/fp-info-cache
hardware/.history/
hardware/~*.lck

# Built site
site/

# Scope captures (several MB each). The decoded result goes in docs/plan.md;
# scripts/decode_capture.py turns a capture back into bytes.
docs/captures/
